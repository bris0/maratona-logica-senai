programa {
  funcao inicio() {
    inteiro t1, t2, t3, media
    escreva("digite o primeiro valor de qualidade: ")
    leia(t1)
    escreva("digite o segundo valor de quantidade: ")
    leia(t2)
    escreva("digite o terceiro valor da quantidade: ")
    leia(t3)
    media = t1 + t2 + t3 / 3
    se (media >= 7)
    escreva("operador Ouro")
    senao
    escreva("precisa de reciclagem")




  }
}
