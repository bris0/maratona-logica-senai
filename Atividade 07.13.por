programa {
  funcao inicio() {
    inteiro a, b
    escreva("Qual é a quantidade de produção do setor a: ")
    leia(a)
    escreva("Qual é a quantidade de produção do setor b: ")
    leia(b)
    se
    (a > b)
    escreva("o setor a produziu mais que o setor b")
    senao
    escreva("o setor b produziu mais que o setor a")
    

    

  }
}
